#!/bin/sh
# git credential helper for GitHub, backed by gh.
#
# git calls this through credential.<url>.helper; credential.<url>.username names
# the account, and the org files in ~/.gitconfig.d/orgs set that per checkout.
#
# `gh auth git-credential` itself serves only the active account: since gh 2.105
# it reads ActiveTokenWithRefresh and hands back nothing (exit 1) when the request
# names another logged-in account. So ask it first - it knows about token refresh
# and expiring credentials - and fall back to the token of the account git asked
# for. `gh auth token --user` refreshes an expiring token as well.
#
# See pkg/cmd/auth/gitcredential/helper.go in cli/cli.
set -u

if [ "${1:-}" != get ]; then
  # store and erase: gh owns the tokens, so there is nothing to persist or drop.
  exit 0
fi

request=$(cat)

native=$(printf '%s\n' "$request" | gh auth git-credential get 2>/dev/null) || native=
if [ -n "$native" ]; then
  printf '%s\n' "$native"
  exit 0
fi

user=$(printf '%s\n' "$request" | sed -n 's/^username=//p')
host=$(printf '%s\n' "$request" | sed -n 's/^host=//p')
if [ -z "$user" ] || [ -z "$host" ]; then
  exit 0
fi

# Gists authenticate against the API host.
host=${host#gist.}

token=$(gh auth token --hostname "$host" --user "$user" 2>/dev/null) || exit 0
if [ -z "$token" ]; then
  exit 0
fi

printf 'username=%s\npassword=%s\n' "$user" "$token"
