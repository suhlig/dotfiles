# Interactively reorder Concourse pipelines
fly-reorder() {
  fly "$@" pipelines --json \
    | jq --raw-output '.[].name' \
    | unique-without-sort \
    | vipe \
    | xargs -I@ echo --pipeline=\"@\" \
    | xargs fly "$@" order-pipelines
}

unique-without-sort(){
  awk '!x[$0]++'
}

# Interactively reorder Concourse pipeline instances
fly-reorder-instances () {
  local target group json

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--target) target="$2"; shift 2 ;;
      -g|--group)  group="$2";  shift 2 ;;
      *) shift ;;
    esac
  done

  json=$(fly --target "$target" pipelines --json \
    | jq --arg g "$group" '[.[] | select(.name == $g and .instance_vars != null)]')

  printf '%s' "$json" \
    | jq --raw-output '
        .[] | .instance_vars | to_entries | map("\(.key):\(.value)") | join(",")
      ' \
    | unique-without-sort \
    | vipe \
    | xargs -I@ echo "--pipeline=@" \
    | xargs fly --target "$target" order-instanced-pipelines --group "$group"
}
