#
# List every open pull request in the repositories you can push to, i.e. the
# ones you could potentially merge, with the URL to open each one in the web UI.
#
# The output is always the same four columns: REPO, TITLE, AUTHOR and URL.
#
# Note that push access does not guarantee a merge: branch protection, required
# reviews and CODEOWNERS may still block you.
#
# Pull requests that Renovate is still holding back because of its minimum
# release age (formerly "stability days") are not mergeable yet, so they are
# listed in a second table below the mergeable ones, introduced by a caption.
# Renovate keeps a `renovate/stability-days` commit status pending on them until
# the release is old enough to be merged.
#
# Extra arguments are passed on to `gh search prs`, e.g.
#
#   gh-prs-i-can-merge --review-requested=@me --no-draft
#
# Set GH_PRS_CHUNK to change how many repositories are queried per request.
#
# The URL column doubles as a clickable link: on a terminal the URL is emitted
# as an OSC 8 hyperlink, so it can be opened directly (cmd-click in iTerm2,
# ghostty, kitty, ...). When the output is piped or redirected the URL is plain
# text. Set GH_PRS_LINKS=1 or GH_PRS_LINKS=0 to force the links on or off, e.g.
#
#   GH_PRS_LINKS=1 gh-prs-i-can-merge | less -R
#

# zsh only; keep quiet when this directory is sourced from .bashrc
[[ -n ${ZSH_VERSION-} ]] || return 0

gh-prs-i-can-merge() {
  emulate -L zsh
  setopt local_options pipe_fail

  local chunk=${GH_PRS_CHUNK:-10}

  # Escape sequences would linger in files and confuse dumb terminals, so only
  # emit hyperlinks when they can actually be followed.
  local hyperlink
  case ${GH_PRS_LINKS-} in
    0) hyperlink=false ;;
    1) hyperlink=true ;;
    *) if [[ -t 1 && ${TERM-} != dumb ]]; then
         hyperlink=true
       else
         hyperlink=false
       fi ;;
  esac

  # Repositories where we have write-ish rights. The REST endpoint is used
  # rather than GraphQL's viewer.repositories because it also includes
  # repositories granted through team membership, and it exposes the per-repo
  # `permissions` we filter on. Sorting explicitly keeps pagination stable.
  local -a repos
  repos=(${(f)"$(
    gh api --paginate '/user/repos?per_page=100&sort=full_name' \
      --jq '.[] | select((.permissions.push or .permissions.maintain or .permissions.admin)
                          and (.archived|not)) | .full_name'
  )"})

  if (( ! ${#repos} )); then
    print -u2 "gh-prs-i-can-merge: no repositories with write access"
    return 1
  fi
  print -u2 "gh-prs-i-can-merge: ${#repos} repositories with write access"

  local tmp
  tmp=$(mktemp) || return 1

  {
    # The search API limits the length of the query, so ask about a few
    # repositories at a time. `${batch/#/--repo=}` turns every element of the
    # array into a single `--repo=<name>` flag.
    local -a batch
    local repo
    for repo in $repos; do
      batch+=($repo)
      (( ${#batch} >= chunk )) || continue
      gh search prs ${batch/#/--repo=} --state=open --limit 100 \
        --json number,title,url,repository,author \
        "$@" >> "$tmp"
      batch=()
    done
    if (( ${#batch} )); then
      gh search prs ${batch/#/--repo=} --state=open --limit 100 \
        --json number,title,url,repository,author \
        "$@" >> "$tmp"
    fi

    # Renovate parks updates that are still inside the configured minimum
    # release age behind a `renovate/stability-days` commit status. The status
    # stays pending until the release has aged enough, so those pull requests
    # cannot be merged yet. The search result carries no status checks, hence
    # the lookup per repository that produced a hit.
    local -a pending
    for repo in ${(u)${(f)"$(jq -r '.[].repository.nameWithOwner' "$tmp")"}}; do
      pending+=(${(f)"$(
        gh pr list --repo "$repo" --state open --limit 1000 \
          --json url,statusCheckRollup \
          --jq '.[] | select(any(.statusCheckRollup[]?;
                                .__typename == "StatusContext"
                                and (.context | test("^renovate/(stability-days|minimum-release-age)$"))
                                and .state == "PENDING"))
                | .url'
      )"})
    done

    # Only pull requests the search actually produced may be listed, so
    # restrict the lookup's result to those.
    local -a found
    found=(${(f)"$(jq -r '.[].url' "$tmp")"})
    pending=(${pending:*found})

    # One filter renders both tables; `--arg section` selects the mergeable or
    # the waiting pull requests.
    local table_program='
      # OSC 8 hyperlink: ESC ] 8 ; ; URI, then ESC followed by a backslash,
      # the visible text, and ESC ] 8 ; ; plus that same ESC-backslash again.
      def link: "\u001b]8;;" + . + "\u001b\\" + . + "\u001b]8;;\u001b\\";

      def waiting: .url as $url | ($pending | split("\n") | index($url)) != null;

      def row: ([.repository.nameWithOwner,
                 .title,
                 (.author.login // "ghost")
                ] | @tsv)
               # @tsv doubles backslashes, which would corrupt the escape
               # sequences, so the URL is appended after escaping instead of
               # escaped itself.
               + "\t" + (if $hyperlink then (.url | link) else .url end);

      (add // []) | unique_by(.url)
      | sort_by(.repository.nameWithOwner, .number)
      | map(select(if $section == "waiting" then waiting else (waiting | not) end))
      | . as $rows
      # An empty waiting list prints nothing at all, so it leaves neither a
      # stray caption nor an empty table behind.
      | if $section == "waiting" and ($rows | length) == 0 then empty
        else (["REPO", "TITLE", "AUTHOR", "URL"] | @tsv), ($rows[] | row) end
    '

    local -a jq_common
    jq_common=(--argjson hyperlink "$hyperlink" --arg pending "${(pj:\n:)pending}")

    jq -s -r "${(@)jq_common}" --arg section ready "$table_program" "$tmp" \
      | column -t -s $'\t'

    local waiting_table
    waiting_table=$(jq -s -r "${(@)jq_common}" --arg section waiting \
                      "$table_program" "$tmp" | column -t -s $'\t') || return 1

    if [[ -n $waiting_table ]]; then
      print
      print "WAITING FOR RENOVATE'S MINIMUM RELEASE AGE"
      print -r -- "$waiting_table"
    fi
  } always {
    rm -f "$tmp"
  }
}