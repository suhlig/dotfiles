# Personal SSH Configuration
# Included work-specific overlay (skipped silently if not present)
Include ~/.ssh/config.work

# Personal Host Aliases
Host pi raspi raspberrypi pi4 wordclock
  User pi
  IdentityFile ~/.ssh/identities/suhlig/id_ed25519
  IdentitiesOnly yes

Host ci *.speisehof.de speisehof.de nowak-reisen.de neon *.tailnet-204f.ts.net
  User root
  IdentityFile ~/.ssh/identities/suhlig/id_ed25519
  IdentitiesOnly yes

Host shop
  HostName shop.tailnet-204f.ts.net
  User suhlig
  IdentityFile ~/.ssh/identities/suhlig/id_ed25519
  IdentitiesOnly yes

# rpizero.local / wordclock-dev: the Mac -> Pi IPv6 TCP path stalls at the
# SSH banner. Prefer IPv4 until the AP/router IPv6 path is fixed.
Host rpizero.local wordclock-dev wordclock-dev.local
  User suhlig
  AddressFamily inet
  IdentityFile ~/.ssh/identities/suhlig/id_ed25519
  IdentitiesOnly yes

# Public GitHub (personal identity)
Host github.com gist.github.com
  User git

# Wildcard Defaults (Always at the bottom)
Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes
  ServerAliveCountMax 600
  ServerAliveInterval 60
  TCPKeepAlive yes
