#!/usr/bin/env zsh

case $WTG_SPACE_EVENT in
  create)
    tmux new-session -d -s "$WTG_SPACE_NAME" -c "$WTG_SPACE_ROOT" -n root

    for dir in ${(f)WTG_REPO_PATHS}; do
      tmux new-window -t "$WTG_SPACE_NAME" -c "$dir" -n "${dir:t}"
    done

    tmux select-window -t "$WTG_SPACE_NAME:0"

    echo "tmux session \"$WTG_SPACE_NAME\" created at $WTG_SPACE_ROOT"
    ;;
  add)
    tmux has-session -t "=$WTG_SPACE_NAME" 2>/dev/null || exit 0

    repos=(${(f)WTG_REPOS})
    paths=(${(f)WTG_REPO_PATHS})
    windows=(${(f)"$(tmux list-windows -t "=$WTG_SPACE_NAME" -F '#{window_name}')"})

    for repo in ${(f)WTG_EVENT_REPOS}; do
      dir=${paths[${repos[(i)$repo]}]}

      if (( ${windows[(Ie)${dir:t}]} )); then
        continue
      fi

      tmux new-window -t "$WTG_SPACE_NAME" -c "$dir" -n "${dir:t}"
      echo "tmux window \"${dir:t}\" added to session \"$WTG_SPACE_NAME\""
    done
    ;;
  remove)
    tmux has-session -t "=$WTG_SPACE_NAME" 2>/dev/null || exit 0

    for repo in ${(f)WTG_EVENT_REPOS}; do
      tmux kill-window -t "=$WTG_SPACE_NAME:=${repo:t}" 2>/dev/null \
        && echo "tmux window \"${repo:t}\" removed from session \"$WTG_SPACE_NAME\""
    done
    ;;
  delete)
    tmux kill-session -t "$WTG_SPACE_NAME" && echo "tmux session \"$WTG_SPACE_NAME\" killed"
    ;;
esac
