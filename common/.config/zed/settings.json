// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "remove_trailing_whitespace_on_save": true,
  "calls": {
    "mute_on_join": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "move_path": {
          "default": "allow"
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^/Users/suhlig/workspace/uhlig\\.it/www/"
            }
          ]
        },
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^/Users/suhlig/workspace/uhlig\\.it/www/"
            }
          ]
        },
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://go\\.dev"
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            }
          ]
        },
        "restore_file_from_disk": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^go\\s+build(\\s|$)"
            },
            {
              "pattern": "^go\\s+test(\\s|$)"
            },
            {
              "pattern": "^go\\s+vet(\\s|$)"
            },
            {
              "pattern": "^true\\b"
            },
            {
              "pattern": "^gofmt\\b"
            },
            {
              "pattern": "^go\\s+get(\\s|$)"
            },
            {
              "pattern": "^go\\s+run(\\s|$)"
            },
            {
              "pattern": "^go\\s+mod(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^goreleaser\\s+jsonschema(\\s|$)"
            },
            {
              "pattern": "^jq\\s+keys(\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\]\\.Build\\.properties(\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\](\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\]\\.Archive\\.properties\\.meta(\\s|$)"
            },
            {
              "pattern": "^goreleaser\\s+build(\\s|$)"
            },
            {
              "pattern": "^brew\\s+list(\\s|$)"
            },
            {
              "pattern": "^echo\\s+libusb(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^echo\\s+not(\\s|$)"
            },
            {
              "pattern": "^pkg-config\\b"
            },
            {
              "pattern": "^go\\s+env(\\s|$)"
            },
            {
              "pattern": "^gh\\s+run(\\s|$)"
            },
            {
              "pattern": "^git-cliff\\b"
            },
            {
              "pattern": "^tail\\b"
            },
            {
              "pattern": "^awk\\b"
            },
            {
              "pattern": "^find\\s+\\.(\\s|$)"
            },
            {
              "pattern": "^sort\\b"
            },
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^zola\\s+build(\\s|$)"
            },
            {
              "pattern": "^find\\s+public/blog/homebrew-top-ten/(\\s|$)"
            },
            {
              "pattern": "^find\\s+public(\\s|$)"
            },
            {
              "pattern": "^go\\s+tool(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+test(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+update(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+build(\\s|$)"
            }
          ]
        },
        "open": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "max",
      "provider": "opencode",
      "model": "go/deepseek-v4-pro",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_family": "IBM Plex Sans",
  "buffer_font_family": "IBM Plex Mono",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Ayu Dark",
}
