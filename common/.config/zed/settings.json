// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "calls": {
    "mute_on_join": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^https?://go\\.dev"
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            }
          ]
        },
        "restore_file_from_disk": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^go\\s+build(\\s|$)"
            },
            {
              "pattern": "^go\\s+test(\\s|$)"
            },
            {
              "pattern": "^go\\s+vet(\\s|$)"
            },
            {
              "pattern": "^true\\b"
            },
            {
              "pattern": "^gofmt\\b"
            },
            {
              "pattern": "^go\\s+get(\\s|$)"
            },
            {
              "pattern": "^go\\s+run(\\s|$)"
            },
            {
              "pattern": "^go\\s+mod(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^goreleaser\\s+jsonschema(\\s|$)"
            },
            {
              "pattern": "^jq\\s+keys(\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\]\\.Build\\.properties(\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\](\\s|$)"
            },
            {
              "pattern": "^jq\\s+\\.\\[\\$defs\\]\\.Archive\\.properties\\.meta(\\s|$)"
            },
            {
              "pattern": "^goreleaser\\s+build(\\s|$)"
            }
          ]
        },
        "open": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "opencode",
      "model": "go/kimi-k2.6",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_family": "IBM Plex Sans",
  "buffer_font_family": "IBM Plex Mono",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Ayu Dark",
}
