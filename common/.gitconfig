[user]
  name = Steffen Uhlig
  email = steffen@familie-uhlig.net
  signingkey = ~/.ssh/identities/suhlig/id_ed25519.pub

[color]
  ui = auto

[alias]
  co = checkout
  ci = duet-commit
  st = status
  br = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
  lg = log
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  logtree = log --graph --oneline --all --decorate

[push]
  default = simple

[pull]
  rebase = true

[rebase]
  autoStash = true

[core]
  excludesfile = ~/.gitignore
  attributesfile = ~/.gitattributes

[commit]
  gpgsign = true

[gpg]
  format = ssh

# https://calebhearth.com/sign-git-with-ssh
[gpg "ssh"]
  allowedsignersfile = ~/.ssh/git-signers

[url "git@github.com:"]
  insteadOf = https://github.com/

[url "git@gist.github.com:"]
  insteadOf = https://gist.github.com/

# https://dev-notes.eu/2022/06/Cargo-Add-for-Dependency-Management/
[url "https://github.com/rust-lang/crates.io-index"]
  insteadOf = https://github.com/rust-lang/crates.io-index

[diff]
  tool = vimdiff
  noprefix = true

[diff "ansible-vault"]
  textconv = ansible-vault view

[init]
  defaultBranch = main

# Includes. Order matters: later imports/settings win.
# Machine-local / work overlay overrides are loaded from ~/.gitconfig.local
[include]
  path = ~/.gitconfig.d/90-osx.conf
  path = ~/.gitconfig.local

# Org-level overrides (formerly in 95-orgs.conf).
# Matched by gitdir or hasconfig, they win over ~/.gitconfig.local.

# Pairing with nerab
[includeIf "gitdir:~/git/github.com/nerab/**"]
  path = ~/.gitconfig.d/orgs/nerab.conf

# Aishe (nowak-reisen & speisehof)
[includeIf "hasconfig:remote.*.url:git@github.com:nowak-reisen/**"]
  path = ~/.gitconfig.d/orgs/nowak-reisen.conf

[includeIf "hasconfig:remote.*.url:https://github.com/nowak-reisen/**"]
  path = ~/.gitconfig.d/orgs/nowak-reisen.conf

[includeIf "hasconfig:remote.*.url:git@github.com:speisehof/**"]
  path = ~/.gitconfig.d/orgs/nowak-reisen.conf

[includeIf "hasconfig:remote.*.url:https://github.com/speisehof/**"]
  path = ~/.gitconfig.d/orgs/nowak-reisen.conf
