[user]
  name = Steffen Uhlig
  email = steffen@familie-uhlig.net
  signingkey = ~/.ssh/identities/suhlig/id_ed25519.pub

[color]
  ui = auto

[alias]
  co = checkout
  ci = duet-commit
  st = status
  br = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:relative)%(color:reset))'
  lg = log
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  logtree = log --graph --oneline --all --decorate

[push]
  default = simple

[pull]
  rebase = true

[rebase]
  autoStash = true

[core]
  excludesfile = ~/.gitignore
  attributesfile = ~/.gitattributes

[commit]
  gpgsign = true

[gpg]
  format = ssh

# https://calebhearth.com/sign-git-with-ssh
[gpg "ssh"]
  allowedsignersfile = ~/.ssh/git-signers

# GitHub is reached over https only. Old clones and tools that still use ssh URLs
# are rewritten, so no ssh key is ever needed for git.
[url "https://github.com/"]
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/

[url "https://gist.github.com/"]
  insteadOf = git@gist.github.com:
  insteadOf = ssh://git@gist.github.com/

# Credentials come from `gh` (log in with `gh auth login -h github.com -p https`).
# The empty helper first drops helpers set at system level (e.g. Homebrew's osxkeychain).
# `username` selects the gh account; the org files in ~/.gitconfig.d/orgs override it.
[credential]
  helper =

[credential "https://github.com"]
  helper = !gh auth git-credential
  username = suhlig

[credential "https://gist.github.com"]
  helper = !gh auth git-credential
  username = suhlig

[diff]
  tool = vimdiff
  noprefix = true

[diff "ansible-vault"]
  textconv = ansible-vault view

[init]
  defaultBranch = main

# Includes. Order matters: later imports/settings win.
# Machine-local / work overlay overrides are loaded from ~/.gitconfig.local
[include]
  path = ~/.gitconfig.local

# Identity per organisation, selected by where the checkout lives. They come after
# ~/.gitconfig.local, so they win over it. Worktrees must therefore live below the
# organisation's directory too.
[includeIf "gitdir:~/git/github.com/nerab/"]
  path = ~/.gitconfig.d/orgs/nerab.conf

[includeIf "gitdir:~/git/github.com/nowak-reisen/"]
  path = ~/.gitconfig.d/orgs/aishe.conf

[includeIf "gitdir:~/git/github.com/speisehof/"]
  path = ~/.gitconfig.d/orgs/aishe.conf
