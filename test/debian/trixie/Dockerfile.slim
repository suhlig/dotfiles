FROM docker.io/debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      locales \
      stow \
      zsh \
 && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen \
 && locale-gen \
 && chsh -s /usr/bin/zsh \
 && rm -rf /var/lib/apt/lists/*

# Same location as on a real machine, because other files refer to it
WORKDIR /root/git/github.com/suhlig/dotfiles
# Testing the dotfiles repo directory
COPY . .
# Alternatively, we can also test the published main branch
# RUN git clone https://github.com/suhlig/dotfiles.git .

RUN DOTFILES_SKIP_UPDATE=1 ./bootstrap.zsh

WORKDIR /root
CMD ["zsh"]
