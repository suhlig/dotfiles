
# Auto-generated tag files
# Persistent undo
# Session
# Swap
# Temporary
## from https://github.com/github/gitignore
*~
.DS_Store
.netrwhist
Session.vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]*.un~
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
common/.config/nvim/plugin
common/Gemfile.lock
tags

# common/.ssh carries configuration only. Keys, known_hosts and anything else
# dropped next to it stay untracked, even if a stow fold ever put them there.
/common/.ssh/*
!/common/.ssh/config
!/common/.ssh/config.d
!/common/.ssh/git-signers
